# Where the member API lives. Leave unset to run against the in-app mock,
# which needs no backend at all (see docs/README.md).
# EXPO_PUBLIC_API_URL=https://test.albarakah.mu

# mock | live. Defaults to mock when EXPO_PUBLIC_API_URL is unset.
EXPO_PUBLIC_API_MODE=mock

# Which app to build: test (Al Barakah Test, mu.albarakah.member.test — the
# default) or production (Al Barakah, mu.albarakah.member). Read by
# app.config.js; see docs/environments.md.
# APP_VARIANT=test
