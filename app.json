{
  "expo": {
    "name": "Al Barakah",
    "slug": "albarakah-member",
    "version": "0.1.0",
    "scheme": "albarakah",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F5C4C"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "mu.albarakah.member",
      "infoPlist": {
        "NSCameraUsageDescription": "Take a photo of a document to file it with your application.",
        "NSPhotoLibraryUsageDescription": "Choose a photo of a document to file it with your application."
      }
    },
    "android": {
      "package": "mu.albarakah.member",
      "adaptiveIcon": {
        "backgroundColor": "#0F5C4C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": ["CAMERA", "READ_MEDIA_IMAGES"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a photo of a document to file it with your application.",
          "cameraPermission": "Take a photo of a document to file it with your application."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
